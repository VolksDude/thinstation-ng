#!/usr/bin/python3
"""Configure manager and first-boot enrollment without reusing endpoint identities."""
import os
import re
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

def main():
    manager = os.environ.get("WAZUH_MANAGER", "").strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,252}", manager):
        sys.exit("Invalid or missing WAZUH_MANAGER in manager.conf")
    config = Path("/var/ossec/etc/ossec.conf")
    if not config.is_file():
        sys.exit("Missing Wazuh agent ossec.conf")
    tree = ET.parse(config)
    root = tree.getroot()
    client = root.find("client")
    if client is None:
        client = ET.SubElement(root, "client")
    server = client.find("server")
    if server is None:
        server = ET.SubElement(client, "server")
    address = server.find("address")
    if address is None:
        address = ET.SubElement(server, "address")
    address.text = manager
    protocol = server.find("protocol")
    if protocol is None:
        protocol = ET.SubElement(server, "protocol")
    protocol.text = "tcp"
    enrollment = client.find("enrollment")
    if enrollment is None:
        enrollment = ET.SubElement(client, "enrollment")
    enabled = enrollment.find("enabled")
    if enabled is None:
        enabled = ET.SubElement(enrollment, "enabled")
    enabled.text = "yes"
    manager_address = enrollment.find("manager_address")
    if manager_address is None:
        manager_address = ET.SubElement(enrollment, "manager_address")
    manager_address.text = manager
    ca = os.environ.get("WAZUH_CA_PATH", "").strip()
    if ca:
        if not Path(ca).is_file():
            sys.exit("WAZUH_CA_PATH does not exist")
        server_ca = enrollment.find("server_ca_path")
        if server_ca is None:
            server_ca = ET.SubElement(enrollment, "server_ca_path")
        server_ca.text = ca
    old_mode = config.stat().st_mode & 0o777
    tmp = config.with_name("ossec.conf.tmp")
    try:
        tree.write(tmp, encoding="unicode", xml_declaration=True)
        os.chmod(tmp, old_mode)
        os.replace(tmp, config)
    finally:
        tmp.unlink(missing_ok=True)
    identity = Path("/var/ossec/etc/client.keys")
    if identity.is_file() and identity.stat().st_size:
        print("Existing Wazuh agent identity will be reused")
    else:
        print("No agent identity; Wazuh enrollment will be required")

if __name__ == "__main__":
    main()
